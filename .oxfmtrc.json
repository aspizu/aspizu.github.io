{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "tabWidth": 2,
  "bracketSpacing": false,
  "printWidth": 80,
  "endOfLine": "lf",
  "sortImports": true,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/main.css"
  },
  "ignorePatterns": [
    ".astro/",
    ".pnpm-store/",
    "dist/",
    "node_modules/",
    "pnpm-lock.yaml",
    "worker-configuration.d.ts",
    "**/*.astro",
    "**/*.jsonc",
    "**/*.mdx",
    "**/*.yaml",
    "**/*.yml"
  ]
}
