{
  "scripts": {
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "typecheck": "tsc --noEmit",
    "lint": "oxfmt --check . && oxlint . && prettier --check \"**/*.{astro,jsonc,mdx,yaml,yml}\" && tailwind-lint --config src/styles/main.css \"src/**/*.{astro,html,js,jsx,md,mdx,svelte,ts,tsx,vue}\"",
    "format": "oxfmt . && prettier --write \"**/*.{astro,jsonc,mdx,yaml,yml}\"",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/figtree": "^5.3.0",
    "astro": "^7.2.9",
    "date-fns": "^4.4.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "pixelarticons": "^2.4.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-lint": "^0.12.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  }
}
