---
import Tooltip from "@/components/Tooltip.astro"

interface Props {
    href: string
    label: string
    dark?: boolean | string
}

const {href, label, dark = false} = Astro.props
const isDark = !dark
---

<Tooltip text={label}>
    <a
        href={href}
        target="_blank"
        rel="noreferrer"
        class:list={[
            "inline-flex size-8 items-center justify-center rounded-full text-xs font-medium transition-colors duration-150",
            isDark
                ? "bg-white/10 text-neutral-400 backdrop-blur-sm hover:bg-white/20 hover:text-neutral-200"
                : "bg-black/5 text-neutral-500 backdrop-blur-sm hover:bg-black/10 hover:text-neutral-800",
        ]}
    >
        <slot />
    </a>
</Tooltip>
