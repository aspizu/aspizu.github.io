---
interface Props {
    class?: string
    text: string
}

const {class: className, text} = Astro.props
---

<div class:list={["group relative inline-block", className]}>
    <slot />
    <div
        class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-2 scale-0 transform rounded-md bg-yellow-100 px-1 py-0.5 text-xs font-medium whitespace-nowrap text-neutral-800 opacity-0 transition-all duration-300 ease-out group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-100"
    >
        {text}
        <div
            class="absolute top-full left-1/2 h-0 w-0 -translate-x-1/2 -translate-y-[0.5px] transform border-t-4 border-r-4 border-l-4 border-transparent border-t-yellow-100"
        >
        </div>
    </div>
</div>
