---
import type {TreeNode} from "#components/ArticleTree.astro"

interface Props {
  currentPath: string
  depth?: number
  folderHref: string
  nodes: TreeNode[]
}

const maxVisibleFiles = 10
const {currentPath, depth = 0, folderHref, nodes} = Astro.props
const normalizedCurrentPath = currentPath.replace(/\/$/, "") || "/"
const directories = nodes
  .filter((node) => node.kind === "directory")
  .toSorted((left, right) => left.name.localeCompare(right.name))
const files = nodes
  .filter((node) => node.kind === "file")
  .toSorted(
    (left, right) =>
      right.updatedAt.localeCompare(left.updatedAt) ||
      left.name.localeCompare(right.name),
  )
const visibleNodes = [
  ...directories,
  ...(depth === 0 ? files : files.slice(0, maxVisibleFiles)),
]
const hiddenFileCount = depth === 0 ? 0 : files.length - maxVisibleFiles
---

<ul
  class="file-tree-branch relative mt-1 ml-[1ch] flex list-none flex-col gap-1 border-l-2 border-c64-dark-grey pl-[calc(2ch+2px)]"
>
  {
    visibleNodes.map((node) => {
      const isCurrentPage =
        normalizedCurrentPath === (node.href.replace(/\/$/, "") || "/")

      return (
        <li class="relative">
          <span
            class="absolute top-[calc(0.5lh-1px)] left-[calc(-2ch-2px)] w-[calc(1.5ch+2px)] border-t-2 border-c64-dark-grey"
            aria-hidden="true"
          />
          {node.kind === "directory" ? (
            <details
              open={
                isCurrentPage ||
                currentPath.startsWith(`${node.href}/`) ||
                depth === 0
              }
            >
              <summary class="cursor-pointer list-none wrap-anywhere text-c64-purple [&::-webkit-details-marker]:hidden">
                <span class="file-tree-closed mr-[0.5ch]" aria-hidden="true">
                  [+]
                </span>
                <span class="file-tree-open mr-[0.5ch]" aria-hidden="true">
                  [-]
                </span>
                <a
                  class:list={[
                    "relative -top-px no-underline hover:text-c64-yellow hover:underline",
                    isCurrentPage ? "text-c64-orange" : "text-c64-purple",
                  ]}
                  href={node.href}
                  title={node.title || node.name}
                  aria-current={isCurrentPage ? "page" : undefined}
                >
                  {node.title || node.name}/
                </a>
              </summary>
              <Astro.self
                nodes={node.children}
                currentPath={currentPath}
                depth={depth + 1}
                folderHref={node.href}
              />
            </details>
          ) : (
            <a
              class:list={[
                "relative -top-px block wrap-anywhere no-underline hover:text-c64-yellow hover:underline",
                isCurrentPage ? "text-c64-orange" : "text-c64-light-blue",
              ]}
              href={node.href}
              title={node.title || node.name}
              aria-current={isCurrentPage ? "page" : undefined}
            >
              {node.title || node.name}
            </a>
          )}
        </li>
      )
    })
  }
  {
    hiddenFileCount > 0 && (
      <li class="relative">
        <span
          class="absolute top-[calc(0.5lh-1px)] left-[calc(-2ch-2px)] w-[calc(1.5ch+2px)] border-t-2 border-c64-dark-grey"
          aria-hidden="true"
        />
        <a
          class="relative -top-px block wrap-anywhere text-c64-light-blue no-underline hover:text-c64-yellow hover:underline"
          href={folderHref}
          title={`View ${hiddenFileCount} more entries`}
        >
          more..
        </a>
      </li>
    )
  }
</ul>

<style>
  .file-tree-branch::after {
    position: absolute;
    bottom: 0;
    left: -2px;
    width: 2px;
    height: calc(0.5lh - 1px);
    background: var(--color-c64-black);
    content: "";
  }

  .file-tree-open,
  details[open] > summary > .file-tree-closed {
    display: none;
  }

  details[open] > summary > .file-tree-open {
    display: inline;
  }
</style>
