---
import ArrowBarRight from "pixelarticons/svg/arrow-bar-right.svg"
---

<button
  class="mobile-sidebar-open flex size-8 shrink-0 cursor-pointer items-center justify-center bg-c64-white p-0 text-c64-purple hover:text-c64-red dark:bg-c64-blue dark:hover:text-c64-yellow"
  type="button"
  aria-controls="site-sidebar"
  aria-expanded="false"
  aria-label="Expand page navigation"
  title="Expand page navigation"
  data-mobile-sidebar-open
>
  <ArrowBarRight class="size-5" aria-hidden="true" />
</button>

<style>
  .mobile-sidebar-open[data-open] {
    display: none;
  }

  @media (min-width: 56rem) {
    .mobile-sidebar-open {
      display: none;
    }

    .mobile-sidebar-open[data-collapsed] {
      display: flex;
    }
  }
</style>
