---
import TreeBranch from "#components/TreeBranch.astro"
import pageLinks from "#content/pages.json"
import {getPageSlug} from "#utils/page-slug"
import {getCollection} from "astro:content"

type TreeDirectory = {
  children: TreeNode[]
  href: string
  kind: "directory"
  name: string
  title: string
}

type TreeFile = {
  href: string
  kind: "file"
  name: string
  title: string
  updatedAt: string
}

export type TreeNode = TreeDirectory | TreeFile

interface Props {
  currentPath: string
}

const currentPath = Astro.props.currentPath.replace(/\/$/, "") || "/"
const pages = await getCollection("pages")
const tree: TreeNode[] = []
const sidebarPages = new Map<string, {title: string; updatedAt: string}>()

for (const page of pages) {
  const slug = getPageSlug(page)
  if (!slug) continue

  sidebarPages.set(slug, {
    title: slug.startsWith("weeknotes/") ? "" : page.data.title,
    updatedAt: page.data.updatedAt.toISOString(),
  })
}

for (const {href, title} of pageLinks) {
  const slug = href.replace(/^\/+|\/+$/g, "")
  if (!slug || sidebarPages.has(slug)) continue

  sidebarPages.set(slug, {title, updatedAt: ""})
}

for (const [slug, page] of sidebarPages) {
  const segments = slug.split("/")
  const fileName = segments.pop() ?? slug
  let currentNodes = tree
  const directorySegments: string[] = []

  for (const segment of segments) {
    directorySegments.push(segment)
    let directory = currentNodes.find(
      (node): node is TreeDirectory =>
        node.kind === "directory" && node.name === segment,
    )

    const directoryPageIndex = currentNodes.findIndex(
      (node) => node.kind === "file" && node.name === segment,
    )

    if (!directory && directoryPageIndex !== -1) {
      const directoryPage = currentNodes[directoryPageIndex]

      if (directoryPage?.kind === "file") {
        directory = {
          children: [],
          href: directoryPage.href,
          kind: "directory",
          name: segment,
          title: directoryPage.title,
        }
        currentNodes[directoryPageIndex] = directory
      }
    }

    if (!directory) {
      directory = {
        children: [],
        href: `/${directorySegments.join("/")}`,
        kind: "directory",
        name: segment,
        title: "",
      }
      currentNodes.push(directory)
    }

    currentNodes = directory.children
  }

  const directory = currentNodes.find(
    (node): node is TreeDirectory =>
      node.kind === "directory" && node.name === fileName,
  )

  if (directory) {
    directory.title = page.title
    continue
  }

  currentNodes.push({
    href: slug ? `/${slug}` : "/",
    kind: "file",
    name: fileName,
    title: page.title,
    updatedAt: page.updatedAt,
  })
}
---

<nav class="text-left" aria-label="Articles">
  <a
    class:list={[
      "no-underline hover:text-c64-red hover:underline dark:hover:text-c64-yellow",
      currentPath === "/" ? "text-c64-orange" : "text-c64-purple",
    ]}
    href="/"
    aria-current={currentPath === "/" ? "page" : undefined}
  >
    aspiz.uk/
  </a>
  <TreeBranch nodes={tree} currentPath={currentPath} folderHref="/" />
</nav>
