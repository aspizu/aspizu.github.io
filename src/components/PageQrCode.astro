---
import QRCode from "qrcode"

interface Props {
  title: string
}

const {title} = Astro.props
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/"
const pageUrl = new URL(pathname, Astro.site).href
const qrCode = await QRCode.toString(pageUrl, {
  type: "svg",
  errorCorrectionLevel: "M",
  margin: 0,
  color: {
    dark: "#6c6c6c",
    light: "#ffffff",
  },
})
---

<footer class="mt-8 mb-16 py-4">
  <div
    class="dark:[&_path:first-child]:fill-c64-blue dark:[&_path:last-child]:stroke-c64-light-grey [&_svg]:block [&_svg]:size-24"
    role="img"
    aria-label={`QR code for ${title}`}
  >
    <Fragment set:html={qrCode} />
  </div>
</footer>
