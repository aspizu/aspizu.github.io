---
import socialIcons from "#assets/social-icons/social-icons.webp"

const socialLinks = [
  {href: "https://github.com/aspizu", label: "GitHub"},
  {
    href: "https://scratch.mit.edu/users/aspizu",
    label: "Scratch",
  },
  {href: "https://reddit.com/u/aspizu", label: "Reddit"},
  {
    href: "https://steamcommunity.com/id/aspizu/",
    label: "Steam",
  },
  {
    href: "https://bsky.app/profile/did:plc:ntwh75drpbi3irhf272raokr",
    label: "Bluesky",
  },
  {
    href: "https://in.pinterest.com/a5pizu/",
    label: "Pinterest",
  },
  {
    href: "https://open.spotify.com/user/31to572so4aje5seeeqhuqftajva?si=d3f656c7532845a7",
    label: "Spotify",
  },
  {
    href: "https://youtube.com/@a5pizu",
    label: "YouTube",
  },
  {href: "https://x.com/aspizu_", label: "X"},
  {
    href: "https://codeberg.org/aspizu",
    label: "Codeberg",
  },
  {href: "https://t.me/aspizu", label: "Telegram"},
  {
    href: "https://discord.gg/mKQqsJ6UtK",
    label: "Discord",
  },
]
---

<div class="grid w-fit grid-cols-6 gap-2 [&_a:active]:translate-y-0.5">
  {
    socialLinks.map(({href, label}, index) => (
      <a class="block size-8" href={href} aria-label={label}>
        <span
          aria-hidden="true"
          class="block size-8 bg-size-[384px_32px] bg-no-repeat [image-rendering:pixelated]"
          style={`background-image: url(${socialIcons.src}); background-position: -${index * 32}px 0`}
        />
      </a>
    ))
  }
</div>
