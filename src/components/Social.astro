---
import Tooltip from "./Tooltip.astro"

interface Props {
    href: string
    color: string
    tooltip: string
}

const {href, color, tooltip} = Astro.props
---

<Tooltip class="Social opacity-0 transition-all" text={tooltip}>
    <a
        class="flex aspect-square items-center justify-center rounded-[35%] bg-white shadow"
        style={{color}}
        target="_blank"
        rel="noreferrer"
        href={href}
    >
        <slot />
    </a>
</Tooltip>
