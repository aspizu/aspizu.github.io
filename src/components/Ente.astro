---
/**
 * This is used in MDX, so don't inline it.
 */
interface Props {
  t: string
}

const {t} = Astro.props
---

<div class="relative h-0 overflow-hidden pb-[75%]">
  <iframe
    class="absolute inset-0 size-full border-0 scheme-light dark:scheme-dark"
    src={`https://embed.ente.com/?t=${t}`}
    title="Ente photo album"
    allowfullscreen></iframe>
</div>
