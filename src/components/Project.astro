---
import ProjectButton from "@/components/ProjectButton.astro"
import BookOpen from "@lucide/astro/icons/book-open"
import Github from "@lucide/astro/icons/github"
import Link from "@lucide/astro/icons/link"
import Star from "@lucide/astro/icons/star"
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right"

interface Props {
    name: string
    description: string
    repo?: string
    docs?: string
    deployment?: string
    image?: string
    size?: "large-image" | "large" | "small"
    dark?: boolean
    stars?: number
}

const {
    name,
    description,
    deployment,
    repo,
    docs,
    image,
    size = "small",
    dark = false,
    stars = 0,
} = Astro.props

const link = deployment ?? docs ?? repo
const starsLabel = `${(Math.floor(stars / 100) * 100).toLocaleString("en-US")}+`
---

<div
    class:list={[
        "Project @container relative flex flex-col rounded-3xl p-1",
        dark ? "bg-gradient-to-br from-neutral-50 to-blue-100" : "bg-neutral-900",
        image ? "row-span-3" : "row-span-2",
        size === "large-image" && "col-span-2 md:col-span-4 md:row-span-3",
        size === "large" && "col-span-2 md:col-span-4 md:row-span-2",
        size === "small" && "col-span-2 md:col-span-2 md:row-span-2",
    ]}
>
    {
        image && (
            <div class="relative overflow-hidden rounded-[21px] shadow">
                <img src={image} alt={name} class="aspect-video w-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
                {link && (
                    <a
                        href={link}
                        target="_blank"
                        rel="noreferrer"
                        class="absolute top-1.5 right-1.5 inline-flex items-center justify-center gap-1 rounded-full bg-white px-2 py-1 text-black/75 backdrop-blur-sm transition-colors duration-150 hover:text-black"
                    >
                        open
                        <ArrowUpRight class="size-3.5" />
                    </a>
                )}
                <div class="absolute right-0 bottom-0 left-0 flex flex-col items-start gap-0 p-4">
                    {stars >= 100 && (
                        <span class="-mb-0.5 inline-flex items-center gap-1 text-base leading-none font-medium text-white/75 @md:text-lg">
                            <img src="/assets/star.png" width={24} height={24} />
                            {starsLabel}
                        </span>
                    )}
                    <h2 class="text-xl leading-none font-medium tracking-tight text-white @sm:text-2xl @md:text-3xl @lg:text-4xl">
                        {name}
                    </h2>
                </div>
            </div>
        )
    }
    <div class="flex min-h-0 flex-1 flex-col gap-2 p-4">
        {
            !image && (
                <div class="flex flex-col items-start gap-0">
                    {stars >= 100 && (
                        <span class="-mb-0.5 inline-flex shrink-0 items-center gap-1 text-base leading-none font-medium text-amber-500/75">
                            <Star class="size-5 fill-amber-500/75" />
                            {starsLabel}
                        </span>
                    )}
                    <h2
                        class:list={[
                            "text-xl leading-none font-medium tracking-tight text-white",
                        ]}
                    >
                        {name}
                    </h2>
                </div>
            )
        }
        <div class="min-h-0 flex-1 overflow-y-auto">
            <p
                class:list={[
                    "leading-relaxed",
                    dark ? "text-neutral-700" : "text-neutral-500",
                ]}
            >
                {description}
            </p>
        </div>
        <div
            class="absolute right-2 bottom-2 flex flex-wrap items-center justify-end gap-2"
        >
            {
                deployment && (
                    <ProjectButton href={deployment} label="Live" dark={dark}>
                        <Link class="size-3.5" />
                    </ProjectButton>
                )
            }
            {
                docs && (
                    <ProjectButton href={docs} label="Docs" dark={dark}>
                        <BookOpen class="size-3.5" />
                    </ProjectButton>
                )
            }
            {
                repo && (
                    <ProjectButton href={repo} label="Repo" dark={dark}>
                        <Github class="size-3.5" />
                    </ProjectButton>
                )
            }
        </div>
    </div>
</div>
