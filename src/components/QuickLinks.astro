---
import BookOpenText from "@lucide/astro/icons/book-open-text"
import BriefcaseBusiness from "@lucide/astro/icons/briefcase-business"
import FileText from "@lucide/astro/icons/file-text"
import Mail from "@lucide/astro/icons/mail"
import Music from "@lucide/astro/icons/music"

const links = [
    {
        href: "mailto:hello@aspiz.uk",
        label: "hello@aspiz.uk",
        icon: Mail,
        iconFirst: false,
    },
    {
        href: "/resume",
        label: "resume",
        icon: BriefcaseBusiness,
        iconFirst: false,
    },
    {
        href: "/blog",
        label: "blog",
        icon: FileText,
        iconFirst: false,
    },
    {
        href: "https://wiki.aspiz.uk",
        label: "wiki",
        icon: BookOpenText,
        iconFirst: false,
    },
    {
        href: "/music",
        label: "music",
        icon: Music,
        iconFirst: false,
    },
]
---

<div class="flex gap-6 text-sm text-white/60">
    {
        links.map((link) => {
            const {href, label, icon: Icon, iconFirst} = link

            return (
                <a
                    href={href}
                    class="inline-flex items-center gap-1 decoration-1 underline-offset-4 transition-colors hover:text-white hover:underline"
                >
                    {iconFirst && <Icon class="size-3.5" />}
                    {label}
                    {!iconFirst && <Icon class="size-3.5" />}
                </a>
            )
        })
    }
</div>
