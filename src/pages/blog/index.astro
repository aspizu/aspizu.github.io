---
import "@/styles/global.css"
import "@fontsource-variable/cascadia-code"
import "@fontsource-variable/figtree"
import ArrowLeft from "@lucide/astro/icons/arrow-left"
import Rss from "@lucide/astro/icons/rss"
import dates from "@/content/dates.json"
import Analytics from "@vercel/analytics/astro"
import {getCollection} from "astro:content"
import * as datefns from "date-fns"

const blogs = (await getCollection("blogs"))
    .map((b) => ({id: b.id, ...b.data, date: new Date(dates[b.id])}))
    .sort((a, b) => b.date.getTime() - a.date.getTime())
---

<!doctype html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>aspizu's blog</title>
        <link rel="icon" href="/assets/favicon.png" />
        <meta name="description" content="technology, music, and whatever else" />
        <meta property="og:title" content="aspizu's blog" />
        <meta
            property="og:description"
            content="technology, music, and whatever else"
        />
        <meta property="og:url" content="https://aspiz.uk/blog" />
        <meta property="og:site_name" content="aspiz.uk" />
        <meta property="og:image" content="https://aspiz.uk/assets/og/index.png" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@aspizu_" />
        <meta name="twitter:title" content="aspizu's blog" />
        <meta
            name="twitter:description"
            content="technology, music, and whatever else"
        />
        <meta name="twitter:creator" content="@aspizu_" />
        <meta name="twitter:image" content="https://aspiz.uk/assets/og/index.png" />
        <meta name="twitter:image:type" content="image/png" />
        <meta name="twitter:image:alt" content="aspizu's blog" />
        <meta
            name="twitter:image:secure_url"
            content="https://aspiz.uk/assets/og/index.png"
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="aspizu's blog" />
        <meta property="og:type" content="website" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="aspizu's blog"
            href="/rss.xml"
        />
        <base href="/blog/" />
    </head>
    <body class="bg-black px-2 py-[10vw] text-neutral-100 sm:px-4">
        <a class="p-author h-card hidden" href="/" aria-hidden="true">aspizu</a>
        <div class="mx-auto max-w-5xl border border-neutral-900">
            <div
                class="flex items-center gap-2 border-b border-dashed border-neutral-900 px-4 py-2 sm:gap-4 sm:px-6 sm:py-4"
            >
                <a
                    href="/"
                    class="flex items-center gap-1 text-sm font-medium text-neutral-400 transition-colors hover:text-white"
                >
                    <ArrowLeft class="size-3" />
                </a>
                <div class="flex min-w-0 flex-col sm:flex-row sm:gap-2">
                    <h1
                        class="p-name shrink-0 text-sm font-semibold tracking-tight text-white"
                    >
                        aspizu's blog
                    </h1>
                    <span class="hidden text-sm text-neutral-500 sm:block">&mdash;</span
                    >
                    <span class="h-description truncate text-xs sm:text-sm"
                        >technology, music, and whatever else</span
                    >
                </div>
                <div class="grow"></div>
                <a
                    href="rss.xml"
                    target="_blank"
                    title="RSS Feed"
                    class="flex size-7 shrink-0 items-center justify-center rounded-full border border-neutral-800 text-neutral-400 transition-colors hover:border-neutral-700 hover:text-white"
                >
                    <Rss class="size-3" />
                </a>
            </div>
            <div class="h-feed">
                <div
                    class="grid grid-cols-1 gap-px bg-neutral-900 sm:grid-cols-2 md:grid-cols-3"
                >
                    {
                        blogs.map((blog) => (
                            <article class="h-entry">
                                <a href={`/blog/${blog.id}`} class="u-url block">
                                    <div class="group flex h-96 flex-col justify-center bg-black px-8 transition-colors hover:bg-neutral-900">
                                        <time
                                            class="dt-published"
                                            datetime={blog.date.toISOString()}
                                        >
                                            <span class="mb-4 place-self-end text-sm font-medium text-neutral-400 transition-colors group-hover:text-white">
                                                {datefns.format(blog.date, "LLL d")}
                                            </span>
                                        </time>
                                        <h2 class="p-name text-3xl leading-tight font-semibold tracking-tight text-white">
                                            {blog.title}
                                        </h2>
                                        <p class="p-summary mt-3 text-pretty text-neutral-400 transition-colors group-hover:text-white">
                                            {blog.description}
                                        </p>
                                        <span class="mt-8 flex items-center gap-2 font-medium text-neutral-400 transition-colors group-hover:text-white">
                                            <img
                                                class="aspect-square rounded-full"
                                                src="/assets/avatar.webp"
                                                alt="Priyanshu Dangare"
                                                width={20}
                                                height={20}
                                            />
                                            aspizu
                                        </span>
                                    </div>
                                </a>
                            </article>
                        ))
                    }
                </div>
            </div>
        </div>
        <Analytics />
    </body>
</html>
