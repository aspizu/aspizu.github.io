---
import "@/styles/global.css"
import "@fontsource-variable/figtree"
import "@fontsource-variable/cascadia-code"
import ArrowLeft from "@lucide/astro/icons/arrow-left"
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right"
import Clock from "@lucide/astro/icons/clock-fading"
import type {CollectionEntry} from "astro:content"
import {getCollection, render} from "astro:content"
import Markdown from "simple-icons-astro/Markdown"
import X from "simple-icons-astro/X"
import * as datefns from "date-fns"
import dates from "@/content/dates.json"
import Analytics from "@vercel/analytics/astro"

interface Props {
    blog: CollectionEntry<"blogs">
}

export async function getStaticPaths() {
    const blogs = await getCollection("blogs")
    return blogs.map((blog) => ({
        params: {slug: blog.id},
        props: {blog},
    }))
}

const {blog} = Astro.props
const {Content} = await render(blog)
const date = new Date(dates[blog.id])

const wordCount = blog.body?.split(/\s+/).length ?? 0
const readTimeMin = Math.ceil(wordCount / 200)

const morePosts = (await getCollection("blogs"))
    .map((b) => ({...b, date: new Date(dates[b.id])}))
    .toSorted((a, b) => b.date.getTime() - a.date.getTime())
    .filter((b) => b.id !== blog.id)
    .slice(0, 3)
---

<!doctype html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{blog.data.title}</title>
        <link rel="icon" href="/assets/favicon.png" />
        <meta property="og:title" content={blog.data.title} />
        <meta property="og:description" content={blog.data.description} />
        <meta property="og:url" content={`https://aspiz.uk/blog/${blog.id}`} />
        <meta property="og:site_name" content="aspiz.uk" />
        <meta
            property="og:image"
            content={`https://aspiz.uk/assets/og/blog/${blog.id}.jpeg`}
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@aspizu_" />
        <meta name="twitter:title" content={blog.data.title} />
        <meta name="twitter:description" content={blog.data.description} />
        <meta name="twitter:creator" content="@aspizu_" />
        <meta
            name="twitter:image"
            content={`https://aspiz.uk/assets/og/blog/${blog.id}.jpeg`}
        />
        <meta name="twitter:image:type" content="image/jpeg" />
        <meta name="twitter:image:alt" content={blog.data.title} />
        <meta name="twitter:image:width" content="1200" />
        <meta name="twitter:image:height" content="630" />
        <meta
            name="twitter:image:secure_url"
            content={`https://aspiz.uk/assets/og/blog/${blog.id}.jpeg`}
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={blog.data.title} />
        <meta property="og:type" content="object" />
        <meta property="article:modified_time" content={date.toISOString()} />
        <base href={`/blog/${blog.id}/`} />
    </head>
    <body class="bg-black px-4 py-[10vw] text-neutral-100">
        <div class="mx-auto max-w-5xl border border-neutral-900">
            <div
                class="flex flex-col items-center border-b border-dashed border-neutral-900 p-[4vw]"
            >
                <a
                    href="/blog"
                    class="my-6 flex items-center gap-1 text-sm font-medium text-neutral-400 transition-colors hover:text-white"
                >
                    <ArrowLeft class="size-3" />Back
                </a>
                <article class="h-entry flex flex-col">
                    <a class="u-url" href={Astro.url.href}></a>
                    <h1
                        class="p-name mb-2 text-center text-[max(min(4vw,3rem),1.5rem)] leading-tight font-semibold tracking-tight text-white"
                    >
                        {blog.data.title}
                    </h1>
                    <h2 class="text-center text-sm leading-relaxed text-neutral-400">
                        {blog.data.description}
                    </h2>
                    <a
                        href="https://twitter.com/@aspizu_"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="p-author h-card mx-auto mt-4 mb-6 inline-flex items-center gap-2 font-medium"
                    >
                        <img
                            class="aspect-square rounded-full"
                            src="/assets/avatar.webp"
                            alt="Priyanshu Dangare"
                            width={20}
                            height={20}
                        />
                        aspizu
                    </a>
                    <div
                        class="font-sm mb-6 flex w-full max-w-3xl flex-wrap gap-4 text-sm text-neutral-400"
                    >
                        <span class="flex items-center gap-2">
                            <Clock class="size-3" />
                            {readTimeMin} min read
                        </span>
                        <button
                            class="flex cursor-pointer items-center gap-2 transition-colors hover:text-white"
                            data-markdown={blog.body}
                            onclick="
                        if (this.dataset.copied === 'true') return;
                        this.dataset.copied = 'true';
                        navigator.clipboard.writeText(this.dataset.markdown);
                        const before = this.innerHTML;
                        this.innerHTML='✓  Copy as Markdown';
                        setTimeout(() => {
                            this.innerHTML = before;
                            this.dataset.copied = 'false';
                        }, 2000);"
                        >
                            <Markdown class="size-3" />Copy as Markdown
                        </button>
                        <div class="grow"></div>
                        <time class="dt-published" datetime={date.toISOString()}>
                            <span
                                >Last updated {
                                    datefns.format(date, "MMMM d, yyyy")
                                }</span
                            >
                        </time>
                    </div>
                </article>
            </div>
            <div class="blog-content mx-auto max-w-3xl p-[4vw]">
                <div class="e-content">
                    <Content />
                </div>
            </div>

            {
                blog.data.tweet && (
                    <div class="border-t border-dashed border-neutral-900 p-[4vw]">
                        <div class="flex justify-center">
                            <a
                                href={blog.data.tweet}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group inline-flex items-center gap-2 rounded-full border border-neutral-800 bg-black px-5 py-2.5 text-sm font-medium transition-colors hover:border-white hover:bg-neutral-200 hover:text-black"
                            >
                                Reply on
                                <X class="size-4" />
                            </a>
                        </div>
                    </div>
                )
            }

            <div class="border-t border-dashed border-neutral-900">
                <h2 class="px-6 py-4 text-sm font-semibold tracking-tight text-white">
                    More posts
                </h2>
                <div
                    class="grid gap-px border-t border-neutral-900 bg-neutral-900 md:grid-cols-2 lg:grid-cols-3"
                >
                    {
                        morePosts.map((post) => (
                            <a
                                href={`/blog/${post.id}`}
                                class="group relative flex flex-col overflow-hidden bg-black px-6 py-4 transition-colors hover:bg-neutral-900"
                            >
                                <ArrowUpRight class="absolute top-4 right-4 size-4 text-neutral-600 group-hover:text-white" />
                                <span class="mb-2 shrink-0 text-xs font-medium text-neutral-400 transition-colors group-hover:text-white">
                                    {datefns.format(post.date, "LLL d")}
                                </span>
                                <h3 class="truncate font-semibold tracking-tight text-white">
                                    {post.data.title}
                                </h3>
                                <p class="mb-2 truncate text-sm text-neutral-400 transition-colors group-hover:text-white">
                                    {post.data.description}
                                </p>
                                <div class="grow" />
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
        <Analytics />
    </body>
</html>
