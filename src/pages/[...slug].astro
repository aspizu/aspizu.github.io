---
import {relative, resolve} from "node:path"

import FolderIndex from "#components/FolderIndex.astro"
import LastFM from "#components/LastFM.astro"
import LastUpdated from "#components/LastUpdated.astro"
import PageQrCode from "#components/PageQrCode.astro"
import Sidebar from "#components/Sidebar.astro"
import SidebarExpandButton from "#components/SidebarExpandButton.astro"
import SiteLogo from "#components/SiteLogo.astro"
import UpFolderLink from "#components/UpFolderLink.astro"
import WeeknotesRssLink from "#components/WeeknotesRssLink.astro"
import "#styles/main.css"
import {getPageSlug} from "#utils/page-slug"
import {getCollection, render} from "astro:content"
import Pencil from "pixelarticons/svg/pencil.svg"

export async function getStaticPaths() {
  const pages = await getCollection("pages")
  const routedPages = pages.map((page) => ({page, slug: getPageSlug(page)}))
  const pageSlugs = new Set(routedPages.map(({slug}) => slug))
  const folderSlugs = new Set<string>()

  for (const {slug} of routedPages) {
    const segments = slug.split("/").slice(0, -1)

    for (let depth = 1; depth <= segments.length; depth += 1) {
      folderSlugs.add(segments.slice(0, depth).join("/"))
    }
  }

  const pagePaths = routedPages.map(({page, slug}) => ({
    params: {slug: slug || undefined},
    props: {kind: "page" as const, page},
  }))
  const folderPaths = [...folderSlugs]
    .filter((slug) => !pageSlugs.has(slug))
    .map((slug) => {
      const prefix = `${slug}/`
      const folderPages = routedPages
        .filter(({slug: pageSlug}) => pageSlug.startsWith(prefix))
        .map(({page, slug: pageSlug}) => {
          return {
            href: `/${pageSlug}`,
            title: page.data.title,
            updatedAt: page.data.updatedAt.toISOString(),
          }
        })
        .toSorted(
          (left, right) =>
            right.updatedAt.localeCompare(left.updatedAt) ||
            left.title.localeCompare(right.title),
        )

      return {
        params: {slug},
        props: {
          folder: {
            name: slug.split("/").at(-1) ?? slug,
            pages: folderPages,
          },
          kind: "folder" as const,
        },
      }
    })

  return [...pagePaths, ...folderPaths]
}

const props = Astro.props
const Content =
  props.kind === "page" ? (await render(props.page)).Content : undefined
const pageTitle =
  props.kind === "folder" ? `${props.folder.name}/` : props.page.data.title
const pageDescription =
  props.kind === "page" ? props.page.data.description : undefined
const lastUpdatedAt =
  props.kind === "page" ? props.page.data.updatedAt.toISOString() : undefined
const sourceCodeHref =
  props.kind === "page" && props.page.filePath
    ? `vscode://file${resolve(
        "/Users/aspizu/Projects/aspiz.uk",
        relative(process.cwd(), resolve(props.page.filePath)),
      )}`
    : undefined
---

<html class="bg-c64-blue text-c64-white accent-c64-light-blue" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/assets/favicon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="aspiz.uk weeknotes"
      href="/weeknotes/rss.xml"
    />
    <link
      rel="preload"
      href="/PiZmono.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {pageDescription && <meta name="description" content={pageDescription} />}
    <title>{pageTitle}</title>
  </head>
  <body class="font-pizmono">
    <div
      class="min-h-screen transition-[grid-template-columns] duration-200 ease-out motion-reduce:transition-none min-[56rem]:grid min-[56rem]:grid-cols-[clamp(14rem,22vw,20rem)_minmax(0,1fr)] min-[56rem]:data-sidebar-collapsed:grid-cols-[0_minmax(0,1fr)]"
      data-page-layout
    >
      <Sidebar currentPath={Astro.url.pathname.replace(/\/$/, "") || "/"} />
      <div
        class="mx-auto w-full max-w-[80ch] px-2 text-justify text-pretty wrap-anywhere"
      >
        <div class="mt-4 flex h-8 items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <SidebarExpandButton />
            <UpFolderLink />
            <WeeknotesRssLink />
          </div>
          <div class="ml-auto flex items-center gap-4">
            {
              sourceCodeHref && (
                <a
                  aria-label="Edit Source"
                  class="source-code-link hidden no-underline hover:no-underline"
                  href={sourceCodeHref}
                  title="Open this page's source in VS Code"
                >
                  <span class="inline-flex items-center gap-1">
                    <Pencil class="size-4.5" aria-hidden="true" />
                    <span>Edit</span>
                  </span>
                </a>
              )
            }
            {lastUpdatedAt && <LastUpdated date={lastUpdatedAt} />}
          </div>
        </div>
        <SiteLogo />
        <main class="markdown">
          {Astro.params.slug && <h1>{pageTitle}</h1>}
          {
            props.kind === "folder" ? (
              <FolderIndex folder={props.folder} />
            ) : Content ? (
              <Content />
            ) : null
          }
        </main>
        <PageQrCode title={pageTitle} />
      </div>
    </div>
    <LastFM />
  </body>
</html>
