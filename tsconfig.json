{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "types": ["astro/client", "vite/client"],
    "paths": {
      "#assets/*": ["./src/assets/*"],
      "#components/*": ["./src/components/*"],
      "#content/*": ["./src/content/*"],
      "#pages/*": ["./src/pages/*"],
      "#styles/*": ["./src/styles/*"],
      "#utils/*": ["./src/utils/*"]
    }
  }
}
